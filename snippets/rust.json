{
  "Rust mod lifecycle": {
    "prefix": "gregmod",
    "body": [
      "extern \"C\" fn on_coins_changed(_event_id: u32, data: u64) {",
      "\tgreg::log_info(&format!(\"coins changed: {data}\"));",
      "}",
      "",
      "#[no_mangle]",
      "pub extern \"C\" fn greg_mod_info() -> greg::GregModInfo {",
      "\tgreg::GregModInfo {",
      "\t\tid: c\"${1:mod_id}\".as_ptr(),",
      "\t\tname: c\"${2:Name}\".as_ptr(),",
      "\t\tversion: c\"1.0.0\".as_ptr(),",
      "\t\tauthor: c\"${3:you}\".as_ptr(),",
      "\t\tdescription: c\"${4:desc}\".as_ptr(),",
      "\t\tapi_version: greg::TABLE_VERSION,",
      "\t}",
      "}",
      "",
      "#[no_mangle]",
      "pub extern \"C\" fn greg_mod_init(api: *const greg::GregCoreAPI) -> bool {",
      "\tif !greg::init(api) { return false; }",
      "\tgreg::subscribe_event(greg::events::PLAYER_COIN_UPDATED, on_coins_changed);",
      "\ttrue",
      "}",
      "",
      "#[no_mangle]",
      "pub extern \"C\" fn greg_mod_update(_dt: f32) {",
      "}",
      "",
      "#[no_mangle]",
      "pub extern \"C\" fn greg_mod_shutdown() {",
      "}"
    ],
    "description": "Minimal gregCore Rust mod lifecycle (greg.rs bindings)."
  },
  "greg subscribe": {
    "prefix": "greg.subscribe_event",
    "body": ["greg::subscribe_event(greg::events::${1:PLAYER_COIN_UPDATED}, ${2:on_event});"],
    "description": "Subscribe to a typed event."
  },
  "greg log": {
    "prefix": "greg.log_info",
    "body": ["greg::log_info(&format!(\"${1:msg}\"));"],
    "description": "Log an info line (mod-tagged by the bridge)."
  }
}
